# .gitignore

# Ignore node_modules
node_modules/

# Ignore log files
*.log

# Ignore build output
dist/
pnpm-workspace.yaml

# Ignore environment files
.env

# Ignore OS-specific files
.DS_Store

# Ignore IDE-specific files
.vscode/
.idea/

# Ignore TypeScript build output
*.tsbuildinfo   

# Ignore coverage reports
coverage/

# Ignore temporary files
*.tmp

# Ignore lockfiles alternativos
yarn.lock

# Ignore other files
ATTRIBUTION.md

